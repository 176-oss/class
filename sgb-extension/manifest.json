{
  "manifest_version": 3,
  "name": "생기부 도우미 - 나이스 연동",
  "short_name": "생기부 도우미",
  "version": "0.4.0",
  "key": "",
  "description": "생기부 작성 도우미에서 완료한 글을 나이스 생기부 입력 화면에 반자동으로 입력합니다. 선생님이 확인한 뒤에만 저장하며 마감·확정은 누르지 않습니다.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "생기부 도우미 열기" },
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel/index.html" },
  "permissions": ["storage", "sidePanel", "identity"],
  "host_permissions": ["https://*.neis.go.kr/*", "http://localhost/*", "http://127.0.0.1/*"],
  "content_scripts": [
    {
      "matches": ["https://*.neis.go.kr/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["content/sgb-bridge.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://*.neis.go.kr/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["content/sgb-config.js", "content/sgb-page.js"],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "MAIN"
    }
  ]
}
